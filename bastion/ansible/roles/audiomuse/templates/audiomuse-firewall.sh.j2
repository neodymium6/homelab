#!/bin/sh
set -eu

iptables=/usr/sbin/iptables
chain={{ audiomuse_firewall_chain | quote }}
proxy_ip={{ audiomuse_proxy_ip | quote }}
web_port={{ audiomuse_web_port | int }}
db_port={{ audiomuse_db_port | int }}

apply_rules() {
  "$iptables" -n -L DOCKER-USER >/dev/null
  "$iptables" -N "$chain" 2>/dev/null || true
  "$iptables" -F "$chain"

  "$iptables" -A "$chain" -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
  "$iptables" -A "$chain" -p tcp -s "$proxy_ip/32" --dport "$web_port" -j RETURN
  "$iptables" -A "$chain" -p tcp --dport "$web_port" -j DROP
  "$iptables" -A "$chain" -i 'br+' -p tcp --dport "$db_port" -j RETURN
{% for cidr in audiomuse_remote_worker_cidrs %}
  "$iptables" -A "$chain" -p tcp -s {{ cidr | quote }} --dport "$db_port" -j RETURN
{% endfor %}
  "$iptables" -A "$chain" -p tcp --dport "$db_port" -j DROP
  "$iptables" -A "$chain" -j RETURN

  while "$iptables" -C DOCKER-USER -j "$chain" 2>/dev/null; do
    "$iptables" -D DOCKER-USER -j "$chain"
  done
  "$iptables" -I DOCKER-USER 1 -j "$chain"
}

remove_rules() {
  while "$iptables" -C DOCKER-USER -j "$chain" 2>/dev/null; do
    "$iptables" -D DOCKER-USER -j "$chain"
  done
  "$iptables" -F "$chain" 2>/dev/null || true
  "$iptables" -X "$chain" 2>/dev/null || true
}

case "${1:-apply}" in
  apply) apply_rules ;;
  remove) remove_rules ;;
  *)
    echo "Usage: $0 {apply|remove}" >&2
    exit 2
    ;;
esac
