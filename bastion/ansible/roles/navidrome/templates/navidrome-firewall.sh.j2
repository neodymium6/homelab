#!/bin/sh
set -eu

iptables=/usr/sbin/iptables
chain={{ navidrome_firewall_chain | quote }}
proxy_ip={{ navidrome_proxy_ip | quote }}
port={{ navidrome_port | int }}

apply_rules() {
  "$iptables" -n -L DOCKER-USER >/dev/null
  "$iptables" -N "$chain" 2>/dev/null || true
  "$iptables" -F "$chain"

  "$iptables" -A "$chain" -p tcp -s "$proxy_ip/32" --dport "$port" -j RETURN
  "$iptables" -A "$chain" -p tcp --dport "$port" -j DROP
  "$iptables" -A "$chain" -j RETURN

  while "$iptables" -C DOCKER-USER -j "$chain" 2>/dev/null; do
    "$iptables" -D DOCKER-USER -j "$chain"
  done
  "$iptables" -I DOCKER-USER 1 -j "$chain"
}

remove_rules() {
  while "$iptables" -C DOCKER-USER -j "$chain" 2>/dev/null; do
    "$iptables" -D DOCKER-USER -j "$chain"
  done
  "$iptables" -F "$chain" 2>/dev/null || true
  "$iptables" -X "$chain" 2>/dev/null || true
}

case "${1:-apply}" in
  apply)
    apply_rules
    ;;
  remove)
    remove_rules
    ;;
  *)
    echo "Usage: $0 {apply|remove}" >&2
    exit 2
    ;;
esac
